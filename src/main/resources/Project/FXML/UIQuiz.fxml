<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.window.Quiz.UIQuizController">
   <children>
      <StackPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <BorderPane fx:id="mainBorderpane" prefHeight="400.0" prefWidth="600.0">
               <bottom>
                  <ToolBar minHeight="8" BorderPane.alignment="CENTER">
                    <items>
                      <Button fx:id="prevButton" mnemonicParsing="false" text="Previous" />
                        <Button fx:id="nextButton" mnemonicParsing="false" text="Next" />
                        <Button fx:id="endButton" mnemonicParsing="false" text="Quit" />
                    </items>
                  </ToolBar>
               </bottom>
               <top>
                  <ToolBar fx:id="questInfoToolbar" BorderPane.alignment="CENTER">
                     <items>
                        <Label fx:id="questProgressLabel" />
                         <Region fx:id="topSpacer1" />
                        <Label fx:id="scoreLabel" />
                         <Region fx:id="topSpacer2" />
                        <Label fx:id="timeLabel" />
                     </items>
                  </ToolBar>
               </top>
               <center>
                  <SplitPane fx:id="questSplitPane" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                     <items>
                        <ScrollPane>
                           <content>
                              <AnchorPane fx:id="questUIAnchorPane" />
                           </content>
                        </ScrollPane>
                     </items>
                  </SplitPane>
               </center>
            </BorderPane>
            <VBox fx:id="mainProgressVBox" alignment="CENTER" managed="false" visible="false"> <!-- style="-fx-background-color: rgba(0,0,0,0.4);" for dark effect -->
               <children>
                  <ProgressIndicator fx:id="mainProgressInd" progress="0.0" />
                  <ProgressBar fx:id="mainProgressBar" prefWidth="200.0" progress="0.0" />
                  <Label fx:id="mainProgressLabel" text="Label" />
               </children>
            </VBox>
            <VBox fx:id="timeupVbox" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" visible="false">
               <children>
                  <Label text="Time up">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Label>
                  <Label fx:id="timeupPtsLabel">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Label>
                  <Button fx:id="timeupQuitButton" mnemonicParsing="false" text="Quit" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
