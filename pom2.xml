  <modelVersion>4.0.0</modelVersion>

  <!--
  How to use via command line:
  run app                                                     -> mvn javafx:run@anatomyExplorer
  build runtime image (executable via anatomyExploer.bat)     -> mvn clean javafx:jlink@anatomyExplorer
  build installer from runtime image                          -> mvn exec:exec@jpackage
  -->

  <!-- use these to configure which installer to build -->
  <!-- use by appending -Pxxx at the end of the mvn command, where xxx is the name of the profile-->

  <profiles>

    <profile>
      <id>windows</id>

      <properties>
        <javafx.platform>win</javafx.platform>
        <jpackage.type>msi</jpackage.type>
      </properties>

      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>

            <executions>
              <execution>
                <id>jpackage</id>

                <configuration>
                  <arguments combine.children="append">

                    <argument>--win-dir-chooser</argument>
                    <argument>--win-shortcut</argument>
                    <argument>--icon</argument>
                    <argument>${project.build.outputDirectory}/Project/icons/skull.ico</argument>

                  </arguments>
                </configuration>

              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>linux</id>
      <properties>
        <javafx.platform>linux</javafx.platform>
        <jpackage.type>deb</jpackage.type>
      </properties>

      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>

            <executions>
              <execution>
                <id>jpackage</id>

                <configuration>
                  <arguments combine.children="append">

                    <argument>--linux-shortcut</argument>
                    <argument>--icon</argument>
                    <argument>${project.build.outputDirectory}/Project/icons/skull.png</argument>

                  </arguments>
                </configuration>

              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>mac</id>
      <properties>
        <javafx.platform>mac</javafx.platform>
        <jpackage.type>dmg</jpackage.type>
      </properties>

      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>

            <executions>
              <execution>
                <id>jpackage</id>

                <configuration>
                  <arguments combine.children="append">

                    <argument>--icon</argument>
                    <argument>${project.build.outputDirectory}/Project/icons/skull.icns</argument>

                  </arguments>
                </configuration>

              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>

